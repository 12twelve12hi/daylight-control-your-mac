<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Light, flat, white: the DC-1 is a paper-like display. No action bar; the page is the UI. -->
  <style name="Theme.TwelveDaylight" parent="Theme.AppCompat.Light.NoActionBar">
    <item name="colorPrimary">@android:color/black</item>
    <item name="colorPrimaryDark">@android:color/white</item>
    <item name="colorAccent">@android:color/black</item>
    <item name="android:windowBackground">@android:color/white</item>
    <!-- Bars are hidden in the app; these apply while they are swiped into view. -->
    <item name="android:statusBarColor">@android:color/white</item>
    <item name="android:navigationBarColor">@android:color/white</item>
    <item name="android:windowLightStatusBar">true</item>
    <item name="android:windowLightNavigationBar">true</item>
  </style>
</resources>
